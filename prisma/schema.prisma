generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTHENTICATION
// ============================================

enum Role {
  USER
  ADMIN
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  bio           String?       @db.Text
  role          Role          @default(USER)
  accounts      Account[]
  sessions      Session[]
  gameWorlds    GameWorld[]
  worldMembers  WorldMember[]
  pins          Pin[]
  loreEntries   LoreEntry[]
  invitesCreated WorldInvite[] @relation("InvitesCreated")
  invitesAccepted WorldInvite[] @relation("InvitesAccepted")
  presences     UserPresence[] @relation("UserPresences")
  events        CollaborationEvent[] @relation("UserEvents")
  characters    Character[]    @relation("CharacterCreator")
  comments      MapComment[]   @relation("UserComments")
  versions      MapVersion[]   @relation("UserVersions")
  importJobs    ImportJob[]    @relation("UserImports")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// GAME WORLDS
// ============================================

enum Permission {
  READER
  EDITOR
  OWNER
}

model GameWorld {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  map         String?
  isPublished Boolean       @default(false)
  isPublic    Boolean       @default(true)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  members     WorldMember[]
  invites     WorldInvite[]
  pins        Pin[]
  layers      MapLayer[]
  loreEntries LoreEntry[]
  collections GalleryCollection[]
  presences   UserPresence[] @relation("WorldPresences")
  events      CollaborationEvent[] @relation("WorldEvents")
  characters  Character[]    @relation("WorldCharacters")
  comments    MapComment[]   @relation("WorldComments")
  versions    MapVersion[]   @relation("WorldVersions")
  importJobs  ImportJob[]    @relation("WorldImports")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([isPublic, createdAt])
  @@index([isPublic, updatedAt])
}

model WorldMember {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameWorldId String
  gameWorld  GameWorld  @relation(fields: [gameWorldId], references: [id], onDelete: Cascade)
  permission Permission @default(READER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([userId, gameWorldId])
  @@index([gameWorldId])
  @@index([userId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

model WorldInvite {
  id              String       @id @default(cuid())
  token           String       @unique
  email           String?
  worldId         String
  world           GameWorld    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  invitedByUserId String
  invitedBy       User         @relation("InvitesCreated", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedByUserId String?     // The user who accepted the invite
  acceptedBy      User?        @relation("InvitesAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  permission      Permission   @default(READER)
  status          InviteStatus @default(PENDING)
  expiresAt       DateTime
  message         String?      @db.Text // Personal message from inviter
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([token])
  @@index([worldId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

// ============================================
// REAL-TIME COLLABORATION
// ============================================

model UserPresence {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserPresences", fields: [userId], references: [id], onDelete: Cascade)
  worldId   String
  world     GameWorld @relation("WorldPresences", fields: [worldId], references: [id], onDelete: Cascade)
  sessionId String   // WebSocket/Socket session identifier
  isActive  Boolean  @default(true)
  lastSeen  DateTime @default(now())
  cursorX   Float?   // Normalized cursor position (0-1)
  cursorY   Float?   // Normalized cursor position (0-1)
  viewport  Json?    // Current viewport { x, y, zoom, width, height }
  selectedPinId String? // Currently selected pin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, worldId, sessionId])
  @@index([worldId, isActive])
  @@index([userId])
  @@index([lastSeen])
}

enum CollaborationEventType {
  PIN_CREATED
  PIN_UPDATED
  PIN_DELETED
  PIN_MOVED
  LAYER_CREATED
  LAYER_UPDATED
  LAYER_DELETED
  LAYER_VISIBILITY_CHANGED
  USER_JOINED
  USER_LEFT
  SELECTION_CHANGED
  COMMENT_CREATED
  COMMENT_UPDATED
  COMMENT_DELETED
  COMMENT_RESOLVED
  COMMENT_REOPENED
}

model CollaborationEvent {
  id        String                 @id @default(cuid())
  worldId   String
  world     GameWorld              @relation("WorldEvents", fields: [worldId], references: [id], onDelete: Cascade)
  userId    String
  user      User                   @relation("UserEvents", fields: [userId], references: [id], onDelete: Cascade)
  eventType CollaborationEventType
  targetId  String?                // ID of the affected entity
  targetType String?               // "pin", "layer", etc.
  eventData  Json?                 // Event-specific data
  timestamp  DateTime               @default(now())

  @@index([worldId, timestamp])
  @@index([eventType, targetId])
  @@index([userId])
}

// ============================================
// MAP LAYERS
// ============================================

model MapLayer {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  isVisible   Boolean   @default(true)
  opacity     Float     @default(1.0)
  zIndex      Int       @default(0)
  offsetX     Float     @default(0) // Pixel offset from top-left (X axis)
  offsetY     Float     @default(0) // Pixel offset from top-left (Y axis)
  scale       Float     @default(1.0) // Visual scale of layer content (0.5 - 2.0)
  minZoom     Int       @default(0)   // Minimum zoom % for layer visibility (0-200)
  maxZoom     Int       @default(200) // Maximum zoom % for layer visibility (0-200)
  gameWorldId String
  gameWorld   GameWorld @relation(fields: [gameWorldId], references: [id], onDelete: Cascade)
  pins        Pin[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([gameWorldId])
}

// ============================================
// PINS (Cities, Villages, POI, Characters)
// ============================================

enum PinType {
  CITY
  VILLAGE
  POI
  CHARACTER
  DUNGEON
  SHOP
  QUEST
  TREASURE
  CUSTOM
}

model Pin {
  id          String              @id @default(cuid())
  title       String
  description String?             @db.Text
  pinType     PinType             @default(CUSTOM)
  latitude    Float
  longitude   Float
  icon        String?
  color       String              @default("#3b82f6")
  size        Int                 @default(32)
  opacity     Float               @default(1.0)
  isVisible   Boolean             @default(true)
  minZoom     Int                 @default(0)
  maxZoom     Int                 @default(200)
  properties  Json?               // Custom properties for RPG data (level, faction, etc.)
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameWorldId String
  gameWorld   GameWorld           @relation(fields: [gameWorldId], references: [id], onDelete: Cascade)
  layerId     String?
  layer       MapLayer?           @relation(fields: [layerId], references: [id], onDelete: SetNull)
  gallery     GalleryItem[]
  loreLinks   LorePinRelation[]   @relation("PinsToLore")
  characterLinks CharacterPinRelation[] @relation("CharacterPins")
  comments    MapComment[]        @relation("PinComments")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([latitude, longitude])
  @@index([gameWorldId])
  @@index([userId])
}

// ============================================
// LORE & KNOWLEDGE
// ============================================

model LoreEntry {
  id          String              @id @default(cuid())
  title       String
  content     String              @db.Text
  slug        String
  category    LoreCategory        @default(GENERAL)
  isVisible   Boolean             @default(false)
  isPublic    Boolean             @default(true)
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameWorldId String
  gameWorld   GameWorld           @relation(fields: [gameWorldId], references: [id], onDelete: Cascade)
  gallery     GalleryItem[]
  pinLinks    LorePinRelation[]   @relation("LoreToPins")
  references  LoreReference[]    @relation("LoreReferences")
  referencedBy LoreReference[]   @relation("ReferencedByLore")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([gameWorldId, slug])
  @@index([gameWorldId])
  @@index([category])
}

enum LoreCategory {
  GENERAL
  HISTORY
  GEOGRAPHY
  CHARACTERS
  FACTIONS
  MAGIC
  ITEMS
  QUESTS
  CUSTOM
}

// Lore-Pin linking relation
enum RelationType {
  REFERENCES    // Lore references this pin location
  DESCRIBES     // Lore describes this pin
  CONTAINS      // Lore mentions what's at this pin
  IS_LOCATED_AT // Lore event happened at this pin
  CUSTOM        // Custom relationship
}

model LorePinRelation {
  id           String       @id @default(cuid())
  loreEntryId  String
  loreEntry    LoreEntry    @relation("LoreToPins", fields: [loreEntryId], references: [id], onDelete: Cascade)
  pinId        String
  pin          Pin          @relation("PinsToLore", fields: [pinId], references: [id], onDelete: Cascade)
  relationType RelationType @default(REFERENCES)
  notes        String?      @db.Text // Optional notes about the relationship
  order        Int          @default(0) // For ordering multiple links
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([loreEntryId, pinId])
  @@index([loreEntryId])
  @@index([pinId])
}

// Lore-to-Lore cross-references
model LoreReference {
  id              String      @id @default(cuid())
  sourceLoreId    String      // The lore entry that contains the link
  sourceLoreEntry LoreEntry   @relation("LoreReferences", fields: [sourceLoreId], references: [id], onDelete: Cascade)
  targetLoreId    String      // The lore entry being linked to
  targetLoreEntry LoreEntry   @relation("ReferencedByLore", fields: [targetLoreId], references: [id], onDelete: Cascade)
  linkText        String      // The text used for the link (e.g., "See Also: Kingdom of Eldoria")
  linkType        String      @default("MENTION") // MENTION, SEE_ALSO, RELATED, CONTRADICTS
  context         String?     @db.Text // Context around the reference
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([sourceLoreId, targetLoreId])
  @@index([sourceLoreId])
  @@index([targetLoreId])
}

// ============================================
// GALLERY & MEDIA
// ============================================

model GalleryItem {
  id            String              @id @default(cuid())
  title         String
  description   String?             @db.Text
  imageUrl      String
  thumbnailUrl  String?             // Generated thumbnail for videos/images
  type          MediaType           @default(IMAGE)
  order         Int                 @default(0)
  width         Int?                // Image/video dimensions
  height        Int?
  size          Int?                // File size in bytes
  format        String?             // File format (jpg, png, mp4, etc.)
  tags          String[]            @default([]) // Searchable tags
  cropData      Json?               // Crop coordinates {x, y, width, height}
  pinId         String?
  pin           Pin?                @relation(fields: [pinId], references: [id], onDelete: Cascade)
  loreEntryId   String?
  loreEntry     LoreEntry?          @relation(fields: [loreEntryId], references: [id], onDelete: Cascade)
  characterId   String?
  character     Character?          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  worldId       String?             // Direct world link for unlinked items
  collections   CollectionItem[]    @relation("GalleryItemCollections")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([pinId])
  @@index([loreEntryId])
  @@index([worldId])
  @@index([tags])
}

model GalleryCollection {
  id          String              @id @default(cuid())
  name        String
  description String?             @db.Text
  color       String?             @default("#3b82f6") // Accent color for UI
  icon        String?             // Icon identifier
  order       Int                 @default(0)
  worldId     String
  world       GameWorld           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  items       CollectionItem[]    @relation("CollectionItems")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([worldId])
}

model CollectionItem {
  id           String             @id @default(cuid())
  galleryItemId String
  galleryItem  GalleryItem        @relation("GalleryItemCollections", fields: [galleryItemId], references: [id], onDelete: Cascade)
  collectionId String
  collection   GalleryCollection  @relation("CollectionItems", fields: [collectionId], references: [id], onDelete: Cascade)
  order        Int                @default(0)
  addedAt      DateTime           @default(now())

  @@unique([galleryItemId, collectionId])
  @@index([collectionId])
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

// ============================================
// CHARACTER-SPECIFIC DATA
// ============================================

enum CharacterType {
  PLAYER       // Player character / PC
  NPC          // Non-player character
  ENEMY        // Hostile creature/NPC
  MERCHANT     // Shop keeper
  QUEST_GIVER  // Provides quests
  COMPANION    // Follower/party member
  BOSS         // Major enemy
  CUSTOM       // Custom type
}

enum CharacterRole {
  PROTAGONIST    // Main hero
  ANTAGONIST     // Main villain
  SUPPORTING     // Supporting character
  BACKGROUND     // Background NPC
  MENTOR         // Teacher/guide
  ALLY           // Friendly to players
  NEUTRAL        // Neutral stance
  HOSTILE        // Enemy to players
  CUSTOM         // Custom role
}

enum RelationshipType {
  FAMILY           // Family relationships
  FRIEND           // Friend
  ENEMY            // Enemy/rival
  MENTOR           // Teacher-student
  COMPANION        // Traveling together
  ROMANTIC         // Romantic interest
  ALLY             // Alliance
  SUBORDINATE      // Master-servant
  CUSTOM           // Custom relationship
}

model Character {
  id              String         @id @default(cuid())
  name            String
  shortName       String?        // Nickname or short name for UI
  characterType   CharacterType  @default(NPC)
  role            CharacterRole  @default(SUPPORTING)

  // Appearance
  portraitUrl     String?        // Character portrait image
  age             Int?
  gender          String?
  species         String?        // Human, Elf, Dwarf, etc.
  height          String?        // Height description
  build           String?        // Physical build

  // RPG Stats (stored as JSON for flexibility)
  level           Int?
  class           String?        // Character class
  faction         String?        // Faction allegiance
  stats           Json?          // { strength, dexterity, constitution, intelligence, wisdom, charisma, etc. }
  skills          Json?          // Array of skill objects { name, level, description }
  equipment       Json?          // Array of equipment { name, type, description }

  // Personality & Background
  personality     String?        @db.Text
  background      String?        @db.Text
  goals           String?        @db.Text
  fears           String?        @db.Text

  // Dialogue & Quests
  dialogue        Json?          // Array of dialogue entries { text, condition, questTrigger }
  quests          Json?          // Array of quest IDs related to this character
  shopInventory   Json?          // Shop items if merchant

  // State
  isVisible       Boolean        @default(true)
  isPublic        Boolean        @default(true)
  order           Int            @default(0)

  // Relations
  userId          String
  user            User           @relation("CharacterCreator", fields: [userId], references: [id], onDelete: Cascade)
  gameWorldId     String
  gameWorld       GameWorld      @relation("WorldCharacters", fields: [gameWorldId], references: [id], onDelete: Cascade)

  // Linked pins (locations associated with character)
  pinLinks        CharacterPinRelation[] @relation("CharacterPins")

  // Relationships with other characters
  relationshipsAsSource  CharacterRelationship[] @relation("RelationshipsFrom")
  relationshipsAsTarget  CharacterRelationship[] @relation("RelationshipsTo")

  // Gallery items (portraits, reference images)
  gallery         GalleryItem[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([gameWorldId])
  @@index([userId])
  @@index([characterType])
  @@index([faction])
  @@index([isVisible, order])
}

// Character-to-Pin linking (like Lore-Pin linking)
model CharacterPinRelation {
  id           String     @id @default(cuid())
  characterId  String
  character    Character  @relation("CharacterPins", fields: [characterId], references: [id], onDelete: Cascade)
  pinId        String
  pin          Pin        @relation("CharacterPins", fields: [pinId], references: [id], onDelete: Cascade)
  relationType String     @default("LOCATION") // HOME, WORK, FREQUENTS, DIED_AT, CUSTOM
  notes        String?    @db.Text // Optional notes about this location
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([characterId, pinId])
  @@index([characterId])
  @@index([pinId])
}

// Relationships between characters
model CharacterRelationship {
  id             String           @id @default(cuid())
  sourceId       String           // The character from whom this relationship originates
  source         Character        @relation("RelationshipsFrom", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId       String           // The character being related to
  target         Character        @relation("RelationshipsTo", fields: [targetId], references: [id], onDelete: Cascade)
  relationshipType RelationshipType @default(FRIEND)
  description    String?          @db.Text // Description of the relationship
  strength       Int?             @default(50) // Relationship strength 0-100
  isVisible      Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
  @@index([relationshipType])
}

// ============================================
// COMMENTS & ANNOTATIONS
// ============================================

model MapComment {
  id          String   @id @default(cuid())
  worldId     String
  world       GameWorld @relation("WorldComments", fields: [worldId], references: [id], onDelete: Cascade)

  // Optional: Attach to pin
  pinId       String?
  pin         Pin?     @relation("PinComments", fields: [pinId], references: [id], onDelete: Cascade)

  // Location for free-standing annotations
  latitude    Float?
  longitude   Float?

  // Comment content
  content     String   @db.Text
  isResolved  Boolean  @default(false)

  // Thread support
  parentId    String?
  parent      MapComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     MapComment[] @relation("CommentReplies")

  // Metadata
  userId      String
  user        User     @relation("UserComments", fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([worldId, isResolved])
  @@index([pinId])
  @@index([parentId])
  @@index([latitude, longitude])
}

// ============================================
// VERSION HISTORY
// ============================================

model MapVersion {
  id        String   @id @default(cuid())
  worldId   String
  world     GameWorld @relation("WorldVersions", fields: [worldId], references: [id], onDelete: Cascade)
  version   Int      // Auto-incrementing version number
  title     String   @default("")
  snapshot  Json     // Complete world state snapshot
  changelog String?  @db.Text // Description of changes
  isAuto    Boolean  @default(false) // Auto-saved vs manual version
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  user      User     @relation("UserVersions", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([worldId])
  @@index([createdAt])
  @@index([worldId, version])
}

// ============================================
// IMPORT FROM TOOLS
// ============================================

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model ImportJob {
  id         String       @id @default(cuid())
  worldId    String
  world      GameWorld    @relation("WorldImports", fields: [worldId], references: [id], onDelete: Cascade)
  sourceType String       // "JSON", "GEOJSON", "IMAGE", "KML", "URL"
  filename   String?      // Original filename
  status     ImportStatus @default(PENDING)
  rawData    Json         // Original imported data
  processed  Json?        // Processed/mapped data
  settings   Json?        // Import settings/options
  error      String?      @db.Text // Error message if failed
  progress   Int          @default(0) // 0-100
  createdBy  String
  user       User         @relation("UserImports", fields: [createdBy], references: [id])
  startedAt  DateTime?
  completedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([worldId])
  @@index([status])
  @@index([createdAt])
}