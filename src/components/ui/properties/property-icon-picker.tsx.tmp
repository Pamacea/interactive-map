/**
 * PropertyIconPicker - Reusable icon picker for property panels
 *
 * Features:
 * - Emoji library with categories
 * - Custom icon upload
 * - Search/filter
 * - Icon preview
 * - Consistent styling
 */

import * as React from "react";
import { cn } from "@/lib/utils";
import { Search, Upload, X } from "lucide-react";

// Emoji categories for fantasy/RPG themes
export const EMOJI_CATEGORIES = {
  locations: {
    label: "Locations",
    icons: ["📍", "🏰", "🏠", "🏯", "🏟️", "⛪", "🕌", "🏛️", "🏔️", "🗻", "🌋", "⛺", "🏕️", "🏝️", "🏜️", "🌳", "🌲", "🌴", "🏙️", "🏘️", "🏚️", "🏭", "⚓", "🚢", "✈️"],
  },
  combat: {
    label: "Combat",
    icons: ["⚔️", "🛡️", "🏹", "🪓", "🗡️", "🔱", "🔥", "💣", "🎯", "🏹"],
  },
  items: {
    label: "Items",
    icons: ["💎", "📜", "🛒", "👤", "👑", "💍", "🗝️", "📦", "🎁", "💰", "💀", "🧪"],
  },
  nature: {
    label: "Nature",
    icons: ["🌊", "💧", "⚡", "❄️", "🌈", "☀️", "🌙", "⭐", "🌍", "🌪️"],
  },
  creatures: {
    label: "Creatures",
    icons: ["🐉", "🦅", "🦁", "🐺", "🦌", "🐲", "🦇", "🐙", "🦑", "🦂", "🐍", "🦎"],
  },
  symbols: {
    label: "Symbols",
    icons: ["❤️", "⚠️", "❓", "❗", "✨", "🎭", "🎪", "🔔", "📌", "🏴", "🚩", "⚜️"],
  },
} as const;

export type EmojiCategory = keyof typeof EMOJI_CATEGORIES;

export interface PropertyIconPickerProps {
  value: string;
  onChange: (icon: string) => void;
  disabled?: boolean;
  categories?: readonly EmojiCategory[];
  showUpload?: boolean;
  onUpload?: (file: File) => Promise<string>;
  accept?: string;
  containerClassName?: string;
  maxSize?: number; // in bytes
}

export function PropertyIconPicker({
  value,
  onChange,
  disabled,
  categories = Object.keys(EMOJI_CATEGORIES) as EmojiCategory[],
  showUpload = false,
  onUpload,
  accept = "image/png,image/webp,image/svg+xml,image/jpeg",
  containerClassName,
  maxSize = 2 * 1024 * 1024, // 2MB
}: PropertyIconPickerProps) {
  const [searchQuery, setSearchQuery] = React.useState("");
  const [isUploading, setIsUploading] = React.useState(false);
  const [uploadError, setUploadError] = React.useState<string | null>(null);
  const fileInputRef = React.useRef<HTMLInputElement>(null);

  // Filter icons based on search
  const filteredCategories = React.useMemo(() => {
    if (!searchQuery) return categories;

    const query = searchQuery.toLowerCase();
    return categories.filter((category) => {
      const catData = EMOJI_CATEGORIES[category];
      return (
        catData.label.toLowerCase().includes(query) ||
        catData.icons.some((icon) =>
          icon.includes(query) || catData.label.toLowerCase().includes(query)
        )
      );
    });
  }, [searchQuery, categories]);

  const handleIconClick = (icon: string) => {
    onChange(icon);
  };

  const handleUploadClick = () => {
    fileInputRef.current?.click();
  };

  const handleFileChange = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file || !onUpload) return;

    // Validation
    if (file.size > maxSize) {
      setUploadError(`File size must be less than ${Math.round(maxSize / 1024 / 1024)}MB`);
      return;
    }

    setIsUploading(true);
    setUploadError(null);

    try {
      const url = await onUpload(file);
      onChange(url);
    } catch (err) {
      setUploadError(err instanceof Error ? err.message : "Upload failed");
    } finally {
      setIsUploading(false);
      // Reset input
      if (fileInputRef.current) {
        fileInputRef.current.value = "";
      }
    }
  };

  const clearUploadError = () => setUploadError(null);

  return (
    <div className={cn("space-y-3", containerClassName)}>
      {/* Search */}
      <div className="relative">
        <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-text-muted" />
        <input
          type="text"
          value={searchQuery}
          onChange={(e) => setSearchQuery(e.target.value)}
          placeholder="Search icons..."
          disabled={disabled}
          className={cn(
            "w-full pl-10 pr-3 py-2 bg-background-input border border-border-subtle rounded-sm text-sm",
            "focus:outline-none focus:border-accent-gold focus:ring-1 focus:ring-accent-gold/30",
            "disabled:opacity-50 disabled:cursor-not-allowed"
          )}
        />
        {searchQuery && (
          <button
            type="button"
            onClick={() => setSearchQuery("")}
            className="absolute right-3 top-1/2 -translate-y-1/2 text-text-muted hover:text-text-primary"
          >
            <X className="h-4 w-4" />
          </button>
        )}
      </div>

      {/* Custom icon upload */}
      {showUpload && onUpload && (
        <div className="flex items-center gap-2">
          <input
            ref={fileInputRef}
            type="file"
            accept={accept}
            onChange={handleFileChange}
            disabled={disabled || isUploading}
            className="hidden"
          />
          <button
            type="button"
            onClick={handleUploadClick}
            disabled={disabled || isUploading}
            className={cn(
              "flex-1 flex items-center justify-center gap-2 px-3 py-2 rounded-sm border border-border-subtle",
              "bg-background-input hover:bg-white/5 transition-colors",
              "disabled:opacity-50 disabled:cursor-not-allowed"
            )}
          >
            <Upload className="h-4 w-4" />
            <span className="text-sm">
              {isUploading ? "Uploading..." : "Upload Custom Icon"}
            </span>
          </button>
          {uploadError && (
            <div className="flex-1">
              <p className="text-xs text-red-400">{uploadError}</p>
              <button
                type="button"
                onClick={clearUploadError}
                className="text-xs text-text-muted hover:text-text-primary"
              >
                Dismiss
              </button>
            </div>
          )}
        </div>
      )}

      {/* Icon grid */}
      <div className="max-h-64 overflow-y-auto space-y-3">
        {filteredCategories.map((category) => {
          const catData = EMOJI_CATEGORIES[category];
          return (
            <div key={category}>
              <p className="text-xs text-text-muted capitalize mb-2 sticky top-0 bg-obsidian py-1">
                {catData.label}
              </p>
              <div className="grid grid-cols-8 gap-1">
                {catData.icons.map((icon) => (
                  <button
                    key={icon}
                    type="button"
                    onClick={() => handleIconClick(icon)}
                    disabled={disabled}
                    className={cn(
                      "w-8 h-8 text-lg rounded-sm border-2 flex items-center justify-center transition-all hover:scale-110",
                      "disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100",
                      value === icon
                        ? "border-accent-gold bg-accent-gold/20"
                        : "border-border-subtle hover:border-accent-gold/50"
                    )}
                    title={icon}
                  >
                    {icon}
                  </button>
                ))}
              </div>
            </div>
          );
        })}

        {filteredCategories.length === 0 && (
          <div className="text-center py-4 text-sm text-text-muted">
            No icons found for &quot;{searchQuery}&quot;
          </div>
        )}
      </div>

      {/* Selected preview */}
      {value && (
        <div className="flex items-center gap-2 p-2 bg-background-input rounded-sm border border-border-subtle">
          <span className="text-sm text-text-muted">Selected:</span>
          <span className="text-xl">{value}</span>
          <button
            type="button"
            onClick={() => onChange("")}
            disabled={disabled}
            className="ml-auto text-text-muted hover:text-red-400 transition-colors disabled:opacity-50"
          >
            <X className="h-4 w-4" />
          </button>
        </div>
      )}
    </div>
  );
}
