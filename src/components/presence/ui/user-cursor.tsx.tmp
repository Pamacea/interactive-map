'use client';

import { memo } from 'react';
import { CursorFlag } from './cursor-flag';
import type { PresenceData } from '@/lib/presence';

interface UserCursorProps {
  userId: string;
  data: PresenceData;
  mapContainer: HTMLElement | null;
}

export const UserCursor = memo<UserCursorProps>(function UserCursor({
  userId,
  data,
  mapContainer: _mapContainer,
}) {
  if (!data.cursorX || !data.cursorY) return null;

  const cursorStyle: React.CSSProperties = {
    position: 'absolute',
    left: `${data.cursorX * 100}%`,
    top: `${data.cursorY * 100}%`,
    pointerEvents: 'none',
    zIndex: 1000,
    transform: 'translate(-4px, -4px)',
    transition: 'left 0.15s ease-out, top 0.15s ease-out',
  };

  const color = getUserColor(userId);

  return (
    <div style={cursorStyle}>
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        className="drop-shadow-lg"
      >
        <path
          d="M5.5 3.21V20.8c0 .45.54.67.85.35l4.86-4.86a.5.5 0 0 1 .35-.15h6.87c.48 0 .72-.58.38-.92L5.94 2.88a.5.5 0 0 0-.44.33z"
          fill={color}
          stroke="white"
          strokeWidth="1.5"
        />
      </svg>
      <CursorFlag name={data.userName} color={color} image={data.userImage} />
    </div>
  );
});

const userColors = [
  '#ef4444',
  '#f97316',
  '#f59e0b',
  '#84cc16',
  '#10b981',
  '#06b6d4',
  '#3b82f6',
  '#8b5cf6',
  '#d946ef',
  '#f43f5e',
];

function getUserColor(userId: string): string {
  let hash = 0;
  for (let i = 0; i < userId.length; i++) {
    hash = userId.charCodeAt(i) + ((hash << 5) - hash);
  }
  return userColors[Math.abs(hash) % userColors.length];
}
