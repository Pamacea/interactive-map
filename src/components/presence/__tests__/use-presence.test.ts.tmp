/**
 * @vitest-environment jsdom
 */

import { describe, it, expect, beforeEach, vi } from 'vitest';
import { renderHook, act } from '@testing-library/react';
import { usePresence } from '../logic/use-presence';

// Mock the polling hook
vi.mock('@/hooks/use-presence-polling', () => ({
  usePresencePolling: vi.fn(() => ({
    sessionId: 'test-session-123',
    presenceUsers: {
      'user-2': {
        userId: 'user-2',
        userName: 'Alice',
        userImage: null,
        cursorX: 0.5,
        cursorY: 0.5,
      } as const,
    },
    updateMyPresence: vi.fn(),
  })),
}));

// Mock the updatePresence server action
vi.mock('@/actions/presence', () => ({
  updatePresence: vi.fn(),
}));

describe('usePresence (polling version)', () => {
  const mockProps = {
    worldId: 'world-1',
    userId: 'user-1',
    userName: 'Test User',
    userImage: 'https://example.com/avatar.jpg',
  };

  beforeEach(() => {
    vi.clearAllMocks();
  });

  it('should initialize with presence data from polling hook', () => {
    const { result } = renderHook(() => usePresence(mockProps));

    expect(result.current.isConnected).toBe(true);
    expect(result.current.sessionId).toBe('test-session-123');
    expect(result.current.presenceUsers).toHaveProperty('user-2');
  });

  it('should initialize myPresence with user data', () => {
    const { result } = renderHook(() => usePresence(mockProps));

    expect(result.current.myPresence).toEqual({
      userId: mockProps.userId,
      userName: mockProps.userName,
      userImage: mockProps.userImage,
    });
  });

  it('should update cursor position', () => {
    const { usePresencePolling } = await import('@/hooks/use-presence-polling');
    const mockUpdate = vi.fn();
    (usePresencePolling as ReturnType<typeof vi.fn>).mockReturnValue({
      sessionId: 'test-session-123',
      presenceUsers: {},
      updateMyPresence: mockUpdate,
    });

    const { result } = renderHook(() => usePresence(mockProps));

    act(() => {
      result.current.updateMyCursor(0.75, 0.25);
    });

    expect(result.current.myPresence.cursorX).toBe(0.75);
    expect(result.current.myPresence.cursorY).toBe(0.25);
    expect(mockUpdate).toHaveBeenCalledWith({ cursorX: 0.75, cursorY: 0.25 });
  });

  it('should update viewport state', () => {
    const { usePresencePolling } = await import('@/hooks/use-presence-polling');
    const mockUpdate = vi.fn();
    (usePresencePolling as ReturnType<typeof vi.fn>).mockReturnValue({
      sessionId: 'test-session-123',
      presenceUsers: {},
      updateMyPresence: mockUpdate,
    });

    const { result } = renderHook(() => usePresence(mockProps));

    const viewport = { x: 100, y: 200, zoom: 1.5 };

    act(() => {
      result.current.updateMyViewport(viewport);
    });

    expect(result.current.myPresence.viewport).toEqual(viewport);
  });

  it('should update selection state', () => {
    const { usePresencePolling } = await import('@/hooks/use-presence-polling');
    const mockUpdate = vi.fn();
    (usePresencePolling as ReturnType<typeof vi.fn>).mockReturnValue({
      sessionId: 'test-session-123',
      presenceUsers: {},
      updateMyPresence: mockUpdate,
    });

    const { result } = renderHook(() => usePresence(mockProps));

    act(() => {
      result.current.updateMySelection('pin-123');
    });

    expect(result.current.myPresence.selectedPinId).toBe('pin-123');
    expect(mockUpdate).toHaveBeenCalledWith({ selectedPinId: 'pin-123' });
  });

  it('should clear selection with null', () => {
    const { usePresencePolling } = await import('@/hooks/use-presence-polling');
    const mockUpdate = vi.fn();
    (usePresencePolling as ReturnType<typeof vi.fn>).mockReturnValue({
      sessionId: 'test-session-123',
      presenceUsers: {},
      updateMyPresence: mockUpdate,
    });

    const { result } = renderHook(() => usePresence(mockProps));

    act(() => {
      result.current.updateMySelection(null);
    });

    expect(result.current.myPresence.selectedPinId).toBeNull();
  });

  it('should work without user image', () => {
    const propsWithoutImage = { ...mockProps, userImage: undefined };
    const { result } = renderHook(() => usePresence(propsWithoutImage));

    expect(result.current.myPresence.userImage).toBeUndefined();
  });
});
