declare module 'clsx' {
  export type ClassValue = string | number | boolean | undefined | null | Record<string, unknown> | ClassValue[];
  export function clsx(...inputs: ClassValue[]): string;
}

declare module 'tailwind-merge' {
  export function twMerge(...inputs: unknown[]): string;
}

declare module 'class-variance-authority' {
  export interface VariantProps<T> {
    variant?: T;
    size?: T;
  }
  export function cva(base: string, config: unknown): unknown;
  export type { VariantProps };
}

declare module 'lucide-react' {
  export * from 'lucide-react';
}