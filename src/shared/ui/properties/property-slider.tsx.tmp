/**
 * PropertySlider - Reusable slider control for property panels
 *
 * Features:
 * - Min/max/step configuration
 * - Value display
 * - Optional reset button
 * - Percentage or absolute value display
 * - Consistent styling
 */

import * as React from "react";
import { cn } from "@/shared/utils";
import { RotateCcw } from "lucide-react";

export interface PropertySliderProps {
  label: string;
  value: number;
  onChange: (value: number) => void;
  min?: number;
  max?: number;
  step?: number;
  disabled?: boolean;
  containerClassName?: string;
  displayValue?: string | ((value: number) => string);
  showReset?: boolean;
  onReset?: () => void;
  defaultValue?: number;
  unit?: string;
}

export function PropertySlider({
  label,
  value,
  onChange,
  min = 0,
  max = 100,
  step = 1,
  disabled,
  containerClassName,
  displayValue,
  showReset,
  onReset,
  defaultValue,
  unit,
}: PropertySliderProps) {
  const formatDisplay = React.useCallback(() => {
    if (displayValue) {
      return typeof displayValue === "function"
        ? displayValue(value)
        : displayValue;
    }
    return unit ? `${value}${unit}` : `${value}`;
  }, [value, displayValue, unit]);

  const handleReset = () => {
    if (defaultValue !== undefined) {
      onChange(defaultValue);
    }
    onReset?.();
  };

  const percentage = ((value - min) / (max - min)) * 100;

  return (
    <div className={cn("space-y-2", containerClassName)}>
      <div className="flex items-center justify-between">
        <span className="text-xs font-display text-text-muted uppercase tracking-wide">
          {label}
        </span>
        <div className="flex items-center gap-2">
          <span className="text-xs font-display font-semibold text-accent-gold px-2 py-0.5 bg-accent-gold/10 rounded">
            {formatDisplay()}
          </span>
          {showReset && (onReset || defaultValue !== undefined) && (
            <button
              type="button"
              onClick={handleReset}
              disabled={disabled}
              className={cn(
                "text-xs text-text-muted hover:text-accent-gold transition-colors",
                "disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-1"
              )}
            >
              <RotateCcw className="w-3 h-3" />
              Reset
            </button>
          )}
        </div>
      </div>

      <div className="relative">
        {/* Track background */}
        <div className="absolute inset-0 h-1.5 bg-obsidian rounded-sm overflow-hidden">
          {/* Filled portion */}
          <div
            className="h-full bg-accent-gold/30"
            style={{ width: `${percentage}%` }}
          />
        </div>

        {/* Actual slider input */}
        <input
          type="range"
          min={min}
          max={max}
          step={step}
          value={value}
          onChange={(e) => onChange(parseFloat(e.target.value))}
          disabled={disabled}
          className={cn(
            "relative w-full h-1.5 appearance-none bg-transparent cursor-pointer",
            "[&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-3.5 [&::-webkit-slider-thumb]:h-3.5",
            "[&::-webkit-slider-thumb]:rounded-sm [&::-webkit-slider-thumb]:bg-accent-gold",
            "[&::-webkit-slider-thumb]:transition-transform [&::-webkit-slider-thumb]:hover:scale-125",
            "[&::-webkit-slider-thumb]:disabled:opacity-50 disabled:opacity-50 disabled:cursor-not-allowed"
          )}
        />
      </div>

      {/* Min/Max labels */}
      <div className="flex justify-between text-xs text-text-muted">
        <span>{min}</span>
        <span>{max}</span>
      </div>
    </div>
  );
}

/**
 * PropertySliderRange - Dual slider for range selection (min/max)
 */
export interface PropertySliderRangeProps {
  label: string;
  min: number;
  max: number;
  minValue: number;
  maxValue: number;
  onMinChange: (value: number) => void;
  onMaxChange: (value: number) => void;
  minLimit?: number;
  maxLimit?: number;
  disabled?: boolean;
  containerClassName?: string;
  onReset?: () => void;
  defaultMin?: number;
  defaultMax?: number;
  unit?: string;
}

export function PropertySliderRange({
  label,
  min: _min,
  max: _max,
  minValue,
  maxValue,
  onMinChange,
  onMaxChange,
  minLimit = 0,
  maxLimit = 200,
  disabled,
  containerClassName,
  onReset,
  defaultMin,
  defaultMax,
  unit = "%",
}: PropertySliderRangeProps) {
  const handleReset = () => {
    if (defaultMin !== undefined) onMinChange(defaultMin);
    if (defaultMax !== undefined) onMaxChange(defaultMax);
    onReset?.();
  };

  return (
    <div className={cn("space-y-3", containerClassName)}>
      <div className="flex items-center justify-between">
        <span className="text-xs font-display font-semibold text-accent-gold uppercase tracking-widest">
          {label}
        </span>
        {(onReset || defaultMin !== undefined || defaultMax !== undefined) && (
          <button
            type="button"
            onClick={handleReset}
            disabled={disabled}
            className="text-xs text-text-muted hover:text-accent-gold transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-1"
          >
            <RotateCcw className="w-3 h-3" />
            Reset
          </button>
        )}
      </div>

      {/* Min slider */}
      <div className="space-y-1.5">
        <div className="flex items-center justify-between">
          <label className="text-xs font-display text-text-muted uppercase tracking-wide">
            Min {label}
          </label>
          <span className="text-xs font-display font-semibold text-accent-gold px-2 py-0.5 bg-accent-gold/10 rounded">
            {minValue}{unit}
          </span>
        </div>
        <input
          type="range"
          min={minLimit}
          max={maxLimit}
          value={minValue}
          onChange={(e) => {
            const val = parseInt(e.target.value);
            if (val < maxValue) onMinChange(val);
          }}
          disabled={disabled}
          className="w-full h-1.5 bg-obsidian rounded-sm appearance-none cursor-pointer accent-accent-gold disabled:opacity-50"
        />
      </div>

      {/* Max slider */}
      <div className="space-y-1.5">
        <div className="flex items-center justify-between">
          <label className="text-xs font-display text-text-muted uppercase tracking-wide">
            Max {label}
          </label>
          <span className="text-xs font-display font-semibold text-accent-gold px-2 py-0.5 bg-accent-gold/10 rounded">
            {maxValue}{unit}
          </span>
        </div>
        <input
          type="range"
          min={minLimit}
          max={maxLimit}
          value={maxValue}
          onChange={(e) => {
            const val = parseInt(e.target.value);
            if (val > minValue) onMaxChange(val);
          }}
          disabled={disabled}
          className="w-full h-1.5 bg-obsidian rounded-sm appearance-none cursor-pointer accent-accent-gold disabled:opacity-50"
        />
      </div>

      {/* Range summary */}
      <div className="text-xs text-text-muted">
        Visible at{" "}
        <span className="font-semibold text-accent-gold bg-accent-gold/10 px-2 py-0.5 rounded">
          {minValue}{unit} - {maxValue}{unit}
        </span>{" "}
        {label.toLowerCase()}
      </div>
    </div>
  );
}
