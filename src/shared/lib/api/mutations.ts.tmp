// ============================================================================
// Invalidation Helpers
// ============================================================================

/**
 * Get query keys to invalidate after a mutation
 */
export const getInvalidationKeys = {
  // Pin mutations affect pins queries and possibly world-complete queries
  pin: (worldId: string) => [
    ["pins"],
    ["worlds", "complete", worldId],
  ],

  // Layer mutations affect layers queries and world-complete queries
  layer: (worldId: string) => [
    ["layers"],
    ["worlds", "complete", worldId],
  ],

  // Lore mutations affect lore queries
  lore: (_worldId: string) => [
    ["lore"],
  ],

  // Character mutations affect characters queries
  character: (_worldId: string) => [
    ["characters"],
  ],

  // Gallery mutations affect gallery queries
  gallery: (_worldId: string) => [
    ["gallery"],
  ],

  // Comment mutations affect comments queries
  comment: (_worldId: string) => [
    ["comments"],
  ],

  // Version mutations affect versions queries and possibly world data
  version: (_worldId: string) => [
    ["versions"],
    ["worlds"],
  ],
} as const;

// ============================================================================
// Optimistic Update Helpers
// ============================================================================

/**
 * Create optimistic update context
 * Helper for rollback on mutation failure
 */
export const createOptimisticContext = <T>(previousData: T) => ({
  previousData,
});

/**
 * Rollback helper for failed mutations
 */
export const rollbackMutation = <T>(
  queryClient: import("@tanstack/react-query").QueryClient,
  queryKey: readonly unknown[],
  context: { previousData: T } | undefined
) => {
  if (context?.previousData) {
    queryClient.setQueryData(queryKey, context.previousData);
  }
};

// ============================================================================
// Mutation Hook Options Factory
// ============================================================================

/**
 * Create standard mutation options with invalidation
 */
export const createMutationOptions = <
  TData,
  TError,
  TVariables,
  TContext = unknown
>(
  mutationFn: (variables: TVariables) => Promise<TData>,
  options: {
    invalidateQueries?: (data: TData, variables: TVariables) => readonly unknown[][];
    onSuccess?: (data: TData, variables: TVariables, context: TContext) => void | Promise<void>;
    onMutate?: (variables: TVariables) => TContext | Promise<TContext>;
    onError?: (error: TError, variables: TVariables, context: TContext | undefined) => void | Promise<void>;
  } = {}
) => {
  return {
    mutationFn,
    onSuccess: (data: TData, variables: TVariables, context: TContext) => {
      options.onSuccess?.(data, variables, context);
    },
    onMutate: options.onMutate,
    onError: options.onError,
  } satisfies import("@tanstack/react-query").UseMutationOptions<TData, TError, TVariables, TContext>;
};
