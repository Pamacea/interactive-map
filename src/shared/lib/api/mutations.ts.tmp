/**
 * Mutations - TanStack Query mutation functions
 *
 * Centralized mutation functions for server data updates.
 * Use these with useMutation for consistent data mutations.
 *
 * Usage:
 *   const mutation = useMutation({
 *     mutationFn: mutations.pins.create,
 *     onSuccess: () => {
 *       queryClient.invalidateQueries({ queryKey: queryKeys.pins.all });
 *     },
 *   })
 */

import {
  createPin,
  updatePin,
  deletePin,
} from "@/features/pins";
import {
  createLayer,
  updateLayer,
  deleteLayer,
  reorderLayers,
} from "@/features/layers";
import {
  createLoreEntry,
  updateLoreEntry,
  deleteLoreEntry,
} from "@/features/lore";
import {
  createCharacter,
  updateCharacter,
  deleteCharacter,
  toggleCharacterVisibility,
  reorderCharacters,
} from "@/features/characters";
import {
  deleteGalleryItem,
  updateGalleryItem,
  reorderGalleryItems,
} from "@/features/gallery";
import {
  createComment,
  updateComment,
  deleteComment,
  toggleCommentResolved,
} from "@/features/comments";
import {
  createVersion,
  restoreVersion,
  deleteVersion,
  updateVersion,
} from "@/features/versions";

// ============================================================================
// Types
// ============================================================================

// Type imports for type inference only - kept for documentation
import type { Pin } from "@prisma/client";
